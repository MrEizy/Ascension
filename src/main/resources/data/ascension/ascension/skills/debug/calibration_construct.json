{
  "type": "ascension:active",
  "name": "Owner Construct",
  "description": "Tests construct replacement, owner damage interception, stability loss, overflow, break and expiry.",
  "definitions": {
    "constructs": {
      "main": {
        "duration": 240,
        "stability": 100,
        "offset": [
          0.0,
          1.8,
          -1.0
        ],
        "rotate_with_owner": true,
        "interception": {
          "absorption": 1.0,
          "stability_cost": 1.0,
          "overflow": true,
          "priority": 1000,
          "on_intercept": [
            {
              "type": "ascension:message",
              "message": "Calibration construct intercepted damage",
              "overlay": true
            },
            {
              "type": "ascension:sound",
              "sound": "minecraft:block.amethyst_block.hit",
              "volume": 0.7,
              "pitch": 1.0
            }
          ],
          "projectile_response": "deflect"
        },
        "on_break": [
          {
            "type": "ascension:message",
            "message": "Calibration construct broken",
            "overlay": true
          },
          {
            "type": "ascension:sound",
            "sound": "minecraft:block.glass.break",
            "volume": 0.8,
            "pitch": 0.8
          }
        ],
        "on_expire": [
          {
            "type": "ascension:message",
            "message": "Calibration construct expired",
            "overlay": true
          }
        ]
      }
    }
  },
  "actions": [
    {
      "type": "ascension:construct",
      "action": "remove",
      "definition": "#main",
      "subject": "caster"
    },
    {
      "type": "ascension:construct",
      "action": "apply",
      "definition": "#main",
      "subject": "caster"
    },
    {
      "type": "ascension:particles",
      "particle": "minecraft:totem_of_undying",
      "count": 32,
      "spread": 0.9,
      "speed": 0.08,
      "subject": "caster"
    },
    {
      "type": "ascension:message",
      "message": "Calibration construct spawned",
      "overlay": true,
      "subject": "caster"
    }
  ],
  "cooldown": 20
}
