{
  "type": "ascension:active",
  "name": "Barrier",
  "description": "Applies a 20 durability barrier for testing absorption, overflow, break, expiry and visual stages.",
  "definitions": {
    "barriers": {
      "main": {
        "duration": 240,
        "durability": 20,
        "absorption": 1.0,
        "overflow": true,
        "priority": 100,
        "replace_existing": true,
        "on_absorb": [
          {
            "type": "ascension:message",
            "message": "Calibration barrier absorbed damage",
            "overlay": true
          }
        ],
        "on_break": [
          {
            "type": "ascension:message",
            "message": "Calibration barrier broken",
            "overlay": true
          },
          {
            "type": "ascension:sound",
            "sound": "minecraft:block.glass.break",
            "volume": 0.8,
            "pitch": 0.75
          }
        ],
        "on_expire": [
          {
            "type": "ascension:message",
            "message": "Calibration barrier expired",
            "overlay": true
          }
        ],
        "visual": {
          "id": "ascension:skill/debug/calibration_barrier/visual/barrier_visual",
          "radius": 1.1,
          "height": 2.25
        },
        "projectile_response": "discard"
      }
    }
  },
  "actions": [
    {
      "type": "ascension:barrier",
      "action": "apply",
      "definition": "#main",
      "subject": "caster"
    },
    {
      "type": "ascension:message",
      "message": "Calibration barrier applied with 20 durability",
      "overlay": true,
      "subject": "caster"
    }
  ],
  "cooldown": 10
}
