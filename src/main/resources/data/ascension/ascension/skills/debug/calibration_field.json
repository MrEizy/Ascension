{
  "type": "ascension:active",
  "name": "Test Field",
  "description": "Tests looked-position targeting, field entry, ticking, exit and expiry.",
  "definitions": {
    "fields": {
      "main": {
        "shape": "cylinder",
        "radius": 4.5,
        "height": 4,
        "duration": 200,
        "tick_interval": 10,
        "filter": {
          "relations": [
            "self",
            "ally",
            "neutral",
            "hostile"
          ],
          "line_of_sight": false
        },
        "on_enter": [
          {
            "type": "ascension:particles",
            "particle": "minecraft:happy_villager",
            "count": 12,
            "spread": 0.45,
            "speed": 0.03
          }
        ],
        "on_tick": [
          {
            "type": "ascension:particles",
            "particle": "minecraft:enchant",
            "count": 5,
            "spread": 0.3,
            "speed": 0.02
          }
        ],
        "on_exit": [
          {
            "type": "ascension:particles",
            "particle": "minecraft:smoke",
            "count": 6,
            "spread": 0.25,
            "speed": 0.01
          }
        ],
        "visual": "ascension:skill/debug/calibration_field/visual/field_visual"
      }
    }
  },
  "target": {
    "type": "ascension:look_position",
    "range": 14,
    "include_fluids": false,
    "fallback_to_maximum_range": true
  },
  "actions": [
    {
      "type": "ascension:field",
      "action": "apply",
      "definition": "#main",
      "subject": "position"
    },
    {
      "type": "ascension:particles",
      "particle": "minecraft:enchant",
      "count": 36,
      "spread": 1.2,
      "speed": 0.04,
      "subject": "position"
    }
  ],
  "cooldown": 20
}
